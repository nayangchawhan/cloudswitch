PORT=3000
NODE_ENV=development

# PostgreSQL — update with your credentials
DATABASE_URL=postgresql://postgres:password@postgres:5432/cloudswitch
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis — update if Redis requires a password
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# JWT — CHANGE THESE IN PRODUCTION
JWT_SECRET=cloudswitch-dev-secret-change-in-production
JWT_REFRESH_SECRET=cloudswitch-refresh-secret-change-in-production
JWT_EXPIRES_IN=7d

# CORS — Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cache TTLs (seconds)
CACHE_TTL_DASHBOARD=60
CACHE_TTL_PROJECTS=30

# Logging
LOG_LEVEL=info
