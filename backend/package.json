{
  "name": "cloudswitch-api",
  "version": "1.0.0",
  "description": "CloudSwitch REST API — cloud-agnostic project & operations management backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testPathPattern=tests --forceExit",
    "test:watch": "jest --testPathPattern=tests --watch",
    "db:migrate": "psql $DATABASE_URL -f ../database/migrations/001_initial_schema.sql",
    "db:seed": "psql $DATABASE_URL -f ../database/seeds/001_demo_data.sql"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["cloudswitch", "api", "express", "postgresql", "redis"],
  "author": "CloudSwitch Dev Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "redis": "^4.6.14",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
